# Database ConfigurationDB_HOST=localhostDB_PORT=5432DB_NAME=procureflowDB_USER=postgresDB_PASSWORD=postgres# Server ConfigurationPORT=8080# ==================================================# AI Provider Configuration# ==================================================# Choose your AI provider: 'openai', 'claude', or 'gemini'# NOTE: OpenAI and Claude have full function calling support# Gemini function calling is not supported in Spring AI 1.0.0-M4AI_PROVIDER=openai# --------------------------------------------------# OpenAI Configuration (when AI_PROVIDER=openai)# --------------------------------------------------OPENAI_API_KEY=your-openai-api-key-hereOPENAI_MODEL=gpt-4o# Available models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo# --------------------------------------------------# Claude/Anthropic Configuration (when AI_PROVIDER=claude)# --------------------------------------------------ANTHROPIC_API_KEY=your-anthropic-api-key-hereCLAUDE_MODEL=claude-3-5-sonnet-20241022# Available models: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307# --------------------------------------------------# Google Gemini Configuration (when AI_PROVIDER=gemini)# --------------------------------------------------# Path to your Google Cloud service account JSON key file# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json# Your Google Cloud Project ID# GCP_PROJECT_ID=your-gcp-project-id# GCP region for Vertex AI# GCP_LOCATION=us-central1# Gemini model to use# GEMINI_MODEL=gemini-1.5-pro# Available models: gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro# ==================================================# Example configurations# ==================================================# Example 1: Using OpenAI with GPT-4o (default)# AI_PROVIDER=openai# OPENAI_API_KEY=sk-proj-...# OPENAI_MODEL=gpt-4o# Example 2: Using OpenAI with GPT-3.5-turbo (cheaper)# AI_PROVIDER=openai# OPENAI_API_KEY=sk-proj-...# OPENAI_MODEL=gpt-3.5-turbo# Example 3: Using Claude 3.5 Sonnet (recommended)# AI_PROVIDER=claude# ANTHROPIC_API_KEY=sk-ant-...# CLAUDE_MODEL=claude-3-5-sonnet-20241022# Example 4: Using Claude 3 Opus (most capable)# AI_PROVIDER=claude# ANTHROPIC_API_KEY=sk-ant-...# CLAUDE_MODEL=claude-3-opus-20240229# Example 5: Using Claude 3 Haiku (fastest, cheapest)# AI_PROVIDER=claude# ANTHROPIC_API_KEY=sk-ant-...# CLAUDE_MODEL=claude-3-haiku-20240307# Example 6: Using Google Gemini Pro# AI_PROVIDER=gemini# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.gcp/service-account-key.json# GCP_PROJECT_ID=my-gcp-project# GCP_LOCATION=us-central1# GEMINI_MODEL=gemini-1.5-pro# Example 7: Using Google Gemini Flash (faster, cheaper)# AI_PROVIDER=gemini# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.gcp/service-account-key.json# GCP_PROJECT_ID=my-gcp-project# GCP_LOCATION=us-central1# GEMINI_MODEL=gemini-1.5-flash