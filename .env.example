# AI Provider Configuration
# Supported values: openai (default), claude (or anthropic), gemini
AI_PROVIDER=openai

# OpenAI API Key (required when using OpenAI provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API Key (required when using Claude provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Cloud Configuration (required when using Gemini provider)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Database Configuration (optional, defaults used in docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procureflow
DB_USER=postgres
DB_PASSWORD=postgres

# Backend Configuration
PORT=8080

# Frontend Configuration
VITE_API_URL=http://localhost:8080
